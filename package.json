{
  "name": "jamesc",
  "version": "2.0.0",
  "description": "jamesc.dev",
  "author": "James Cockshull",
  "scripts": {
    "dev": "npm run build && run-p dev:*",
    "dev:wrangler": "wrangler dev --live-reload",
    "dev:css": "tailwindcss -i ./src/app.css -o ./dist/app.css --watch",
    "build": "cp -r ./public/ ./dist && tailwindcss --minify -i ./src/app.css -o ./dist/app.css",
    "deploy": "npm run build && wrangler deploy",
    "tail": "wrangler tail",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings --include-runtime=false"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.11",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.1.11",
    "typescript": "^7.0.2",
    "wrangler": "^4.149.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cone56/jamesc.git"
  },
  "licence": "MIT"
}
