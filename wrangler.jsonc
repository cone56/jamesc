{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jamesc",
  "main": "./src/server.tsx",
  "compatibility_date": "2023-07-24",
  "compatibility_flags": ["rpc"],
  "assets": {
    "directory": "./dist"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "COUNTER",
        "class_name": "Counter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Counter"]
    }
  ]
}