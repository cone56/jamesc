{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jamesc",
  "main": "./src/server.tsx",
  "compatibility_date": "2023-07-24",
  "compatibility_flags": ["rpc"],
  "cache": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "COUNTER",
        "class_name": "Counter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Counter"]
    }
  ],
  "previews": {
    "durable_objects": {
      "bindings": [
        {
          "name": "COUNTER",
          "class_name": "Counter"
        }
      ]
    }
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  },
}